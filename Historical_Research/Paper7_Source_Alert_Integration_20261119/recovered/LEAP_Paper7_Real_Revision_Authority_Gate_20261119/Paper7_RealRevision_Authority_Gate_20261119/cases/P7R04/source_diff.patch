--- before/sample_project/tsql_kpi.tsql
+++ after/sample_project/tsql_kpi.tsql
@@ -1,5 +1,5 @@
--- KPI: On-Spec Rate (%)
--- Math Formula: On-Spec Rate = (100 * On-Spec Batches) / Total Batches
+-- KPI: On Spec Rate
+-- Formula: \mathrm{On\ Spec\ Rate} = \frac{\mathrm{On\ Spec\ Batches}}{\mathrm{Total\ Batches}} \times 100
 CREATE VIEW kpi_on_spec_rate AS
 SELECT
     CAST(100.0 * on_spec_batches / NULLIF(total_batches, 0) AS FLOAT) AS on_spec_percentage
